APP_NAME="Yandex Maps Reviews"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=ru
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=ru_RU

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Values for running on the host; docker-compose overrides DB_HOST with the service name.
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=yandex_parser
DB_USERNAME=app
DB_PASSWORD=secret

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# Hosts (with port) whose requests get cookie-based SPA authentication.
SANCTUM_STATEFUL_DOMAINS=localhost:8000,127.0.0.1:8000

# Behind TLS in production set SESSION_SECURE_COOKIE=true.
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax

LOGIN_MAX_ATTEMPTS=5
LOGIN_DECAY_SECONDS=60

# Page sizes of the lists and how many metrics snapshots the history endpoint returns.
REVIEWS_PER_PAGE=50
ORGANIZATIONS_PER_PAGE=50
ORGANIZATION_HISTORY_LIMIT=50

ORGANIZATION_CONNECT_MAX_ATTEMPTS=10
ORGANIZATION_CONNECT_DECAY_SECONDS=60

# Card URL stored for an organization; {external_id} is replaced with the platform id.
YANDEX_CANONICAL_URL="https://yandex.ru/maps/org/{external_id}/"
SCRAPING_SHORT_LINK_MAX_HOPS=3

SCRAPING_HTTP_TIMEOUT=15
SCRAPING_HTTP_CONNECT_TIMEOUT=5
SCRAPING_LOG_LEVEL=info

# Anti-ban (ADR-004). State store must support locks; empty = default cache store.
SCRAPING_STATE_STORE=
SCRAPING_THROTTLE_MIN_INTERVAL_MS=1500
SCRAPING_THROTTLE_JITTER_MS=1000
SCRAPING_BREAKER_FAILURE_THRESHOLD=3
SCRAPING_BREAKER_OPEN_SECONDS=900
# Comma-separated proxy URLs, e.g. http://user:pass@1.2.3.4:8080; empty = the server's own IP.
SCRAPING_PROXIES=
SCRAPING_PROXY_BAN_SECONDS=1800
SCRAPING_RATE_LIMIT_COOLDOWN_SECONDS=300
# Reference card of each platform for `scraping:canary`, and how source health is judged (ADR-009).
YANDEX_CANARY_URL="https://yandex.ru/maps/org/1703836794/"
SCRAPING_HEALTH_WINDOW=20
SCRAPING_HEALTH_DEGRADED_SHARE=0.3
SCRAPING_HEALTH_TTL_SECONDS=86400
SCRAPING_PAYLOAD_RETENTION_DAYS=14

SCRAPING_RETRY_BASE_SECONDS=30
SCRAPING_RETRY_BLOCKED_BASE_SECONDS=600
SCRAPING_RETRY_MAX_SECONDS=3600

# Must stay above the sync job timeout, or a long collection is handed to a second worker.
DB_QUEUE_RETRY_AFTER=960

SYNC_QUEUE=scraping
SYNC_MAX_ATTEMPTS=5
SYNC_RETRY_UNTIL_MINUTES=180
SYNC_COMPLETENESS_TOLERANCE=0.01
SYNC_POLLING_INTERVAL_MS=2000
SYNC_SLOW_AFTER_SECONDS=300
SYNC_RESYNC_INTERVAL_MINUTES=1440
SYNC_RESYNC_BATCH_SIZE=5
SYNC_MANUAL_MAX_ATTEMPTS=10
SYNC_MANUAL_DECAY_SECONDS=300

YANDEX_BASE_URL=https://yandex.ru
YANDEX_REVIEWS_LOCALE=ru_RU
# Yandex serves only this many latest reviews of an organization.
YANDEX_REVIEWS_MAX_AVAILABLE=600

# Progress of a collection is pushed over websockets (ADR-008). The SPA reads these values from /app-config,
# never from its own build-time env; REVERB_HOST/PORT/SCHEME are what the browser connects to, the SERVER_*
# pair is what `php artisan reverb:start` binds to.
BROADCAST_CONNECTION=reverb
REVERB_APP_ID=local
REVERB_APP_KEY=local-key
REVERB_APP_SECRET=local-secret
REVERB_HOST=127.0.0.1
REVERB_PORT=8080
REVERB_SCHEME=http
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8080

FILESYSTEM_DISK=local
# Queue, cache (including the anti-ban state) and sessions all live in the database; no Redis is needed.
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# docker-compose
APP_PORT=8000
VITE_PORT=5173
FORWARD_DB_PORT=5432
DOCKER_UID=1000
DOCKER_GID=1000
